__pycache__/
*.py[cod]
.venv/
venv/

# Machine-written calibration + local settings
calibration.json
config.toml

# Session handoff notes: working notes about a moment, not documentation.
# Anything durably true belongs in .claude/CONTEXT.md instead.
.claude/handoffs/*
!.claude/handoffs/.gitkeep

# Local logs, rotated at 2MB x 5
logs/

# Captured frames and debug crops (auto-pruned after storage.retain_days)
captures/
debug/

# Curated training samples - kept forever, but not source code
samples/
icon_template.png
